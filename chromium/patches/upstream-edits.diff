 DEFINE_USER_DATA(DevtoolsUIController);
 
+namespace {
+
+// Returns true if |browser| is a WebDeck window. WebDeck windows draw their own
+// browser chrome and position the active tab into an inset "stage" rect; a
+// docked DevTools panel splits the contents area and fights that layout, so
+// WebDeck windows must open DevTools undocked (windowed). Detection mirrors
+// ContentsContainerView (chrome/browser/ui/views/frame/contents_container_view.cc).
+bool IsWebDeckWindow(BrowserWindowInterface* browser) {
+  const BrowserInitState* const init_state = BrowserInitState::From(browser);
+  return init_state &&
+         init_state->browser_window_create_params().is_webdeck_window;
+}
+
