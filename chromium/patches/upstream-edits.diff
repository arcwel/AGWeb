+// The WebDeck shell's WebView. views::WebView is the shell WebContents'
+// delegate, but it drops DraggableRegionsChanged — so this override captures
+// the shell's -webkit-app-region regions and hands them to the owning
+// container, where BrowserView::NonClientHitTest consults them to let the shell
+// draw its own draggable title bar (the shell is not a web-app window, so the
+// AppBrowserController draggable-region path never fires for it).
+class ShellWebView : public views::WebView {
+  METADATA_HEADER(ShellWebView, views::WebView)
+
+ public:
+  ShellWebView(content::BrowserContext* context,
+               ContentsContainerView* owner)
+      : views::WebView(context), owner_(owner) {}
+  ShellWebView(const ShellWebView&) = delete;
+  ShellWebView& operator=(const ShellWebView&) = delete;
+  ~ShellWebView() override = default;
+
+  // content::WebContentsDelegate (via views::WebView):
+  void DraggableRegionsChanged(
+      const std::vector<blink::mojom::DraggableRegionPtr>& regions,
+      content::WebContents* contents) override {
+    SkRegion sk_region;
+    for (const blink::mojom::DraggableRegionPtr& region : regions) {
+      sk_region.op(
+          SkIRect::MakeLTRB(region->bounds.x(), region->bounds.y(),
+                            region->bounds.x() + region->bounds.width(),
+                            region->bounds.y() + region->bounds.height()),
+          region->draggable ? SkRegion::kUnion_Op : SkRegion::kDifference_Op);
+    }
+    owner_->SetShellDraggableRegion(sk_region);
+  }
+
+ private:
+  const raw_ptr<ContentsContainerView> owner_;
+};
+
