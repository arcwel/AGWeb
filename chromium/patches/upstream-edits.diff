index 8bc1daffbfa45..6e234c3a511bf 100644
--- a/chrome/browser/chrome_browser_interface_binders_webui.cc
+++ b/chrome/browser/chrome_browser_interface_binders_webui.cc
@@ -13,6 +13,8 @@
 #include "chrome/browser/ui/webui/actor_internals/actor_internals_ui.h"
 #include "chrome/browser/ui/webui/bluetooth_internals/bluetooth_internals.mojom.h"
 #include "chrome/browser/ui/webui/bluetooth_internals/bluetooth_internals_ui.h"
+#include "chrome/browser/ui/webui/webdeck/webdeck.mojom.h"
+#include "chrome/browser/ui/webui/webdeck/webdeck_ui.h"
 #include "chrome/browser/ui/webui/chrome_finds_internals/chrome_finds_internals.mojom.h"
 #include "chrome/browser/ui/webui/chrome_finds_internals/chrome_finds_internals_ui.h"
 #include "chrome/browser/ui/webui/chrome_urls/chrome_urls_ui.h"
@@ -184,6 +186,15 @@ void PopulateChromeWebUIFrameBindersPartsAllPlatforms(
   RegisterWebUIControllerInterfaceBinder<::mojom::BluetoothInternalsHandler,
                                          BluetoothInternalsUI>(map);
 
+  // WebDeck: the agent drives tabs in the user's own session through this.
+  // Registered per WebUI controller, so it is reachable ONLY from
+  // chrome://webdeck and from nowhere else in the browser.
+  RegisterWebUIControllerInterfaceBinder<webdeck::mojom::AgentTabs, WebDeckUI>(
+      map);
+  // WebDeck: the shell's own tab strip / toolbar drive the window's real tabs
+  // and stream the stage rect. Also reachable ONLY from chrome://webdeck.
+  RegisterWebUIControllerInterfaceBinder<webdeck::mojom::Shell, WebDeckUI>(map);
+
   RegisterWebUIControllerInterfaceBinder<
       media::mojom::MediaEngagementScoreDetailsProvider, MediaEngagementUI>(
       map);
