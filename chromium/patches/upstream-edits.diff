+void ContentsContainerView::SetSecondaryStagedContents(
+    content::WebContents* contents) {
+  if (!secondary_contents_view_) {
+    // Non-WebDeck window (or non-primary container): no secondary stage exists.
+    return;
+  }
+  // Mirror MultiContentsView::SetWebContentsAtIndex: host the (background) tab's
+  // WebContents in the secondary ContentsWebView and reinstall its SadTabHelper
+  // so a crashed tab still paints its sad-tab page in the new view.
+  secondary_contents_view_->SetWebContents(contents);
+  if (contents) {
+    // Guard against painting at the PREVIOUS split's rect. The view still holds
+    // the bounds it was last laid out at, but on a fresh split session
+    // `secondary_strategy_` is empty again (reset on the prior teardown, below)
+    // until the shell streams the new stage rect via SetSecondaryStageBounds —
+    // and CalculateProposedLayout leaves the view untouched while that rect is
+    // empty. Reset to an empty rect before showing so nothing paints until the
+    // real rect arrives, mirroring how the primary stage is never left at a
+    // stale rect (it always lays out, with a static-inset fallback before the
+    // shell has measured).
+    secondary_contents_view_->SetBoundsRect(gfx::Rect());
+    secondary_contents_view_->SetVisible(true);
+    if (auto* sad_tab_helper = SadTabHelper::FromWebContents(contents)) {
+      sad_tab_helper->ReinstallInWebView();
+    }
+  } else {
+    secondary_contents_view_->SetVisible(false);
+    // Tearing the split down: forget the secondary stage rect so the layout
+    // guard (below) drops the secondary view until the next SetSplit.
+    secondary_strategy_.CopyFrom(DevToolsContentsResizingStrategy());
+  }
+  InvalidateLayout();
+}
+
+void ContentsContainerView::SetSecondaryContentsResizingStrategy(
+    const DevToolsContentsResizingStrategy& strategy) {
+  if (secondary_strategy_.Equals(strategy)) {
+    return;
+  }
+
+  secondary_strategy_.CopyFrom(strategy);
+  InvalidateLayout();
+}
