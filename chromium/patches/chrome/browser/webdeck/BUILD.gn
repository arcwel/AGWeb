assert(is_win || is_mac || is_linux)

source_set("core_service") {
  sources = [
    "webdeck_core_service.cc",
    "webdeck_core_service.h",
  ]

  deps = [
    "//base",
    "//chrome/common:constants",
    # So the core can report which browser build it belongs to.
    "//components/version_info",
  ]
}

# Links the WebDeck shell's WebContents back to its owning window. Kept in a tiny
# leaf target (base + content only) so both the views layer
# (ContentsContainerView) and the WebUI Shell impl can depend on it without a
# dependency cycle.
source_set("shell_host") {
  sources = [
    "webdeck_shell_host.cc",
    "webdeck_shell_host.h",
  ]

  deps = [
    "//base",
    "//content/public/browser",
  ]
}
